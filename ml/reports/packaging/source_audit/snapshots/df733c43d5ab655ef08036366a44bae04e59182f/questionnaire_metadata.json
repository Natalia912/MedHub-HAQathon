      "step": 0,
      "default": false,
      "options": [
        [
          false,
          "Для себя"
        ],
        [
          true,
          "Для ребёнка"
        ]
      ]
    },
    {
      "name": "sex",
      "label": "Пол",
      "type": "select",
      "step": 0,
      "required": true,
      "options": [
        [
          "F",
          "Женский"
        ],
        [
          "M",
          "Мужской"
        ]
      ]
