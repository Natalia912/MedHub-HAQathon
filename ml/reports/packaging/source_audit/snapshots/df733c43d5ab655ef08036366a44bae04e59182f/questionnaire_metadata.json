      "step": 3,
      "layout": "stack",
      "exclusive": "none",
      "hint": "Отметьте всё, что подходит.",
      "options": {
        "source_expression_only": "CONDITION_OPTIONS + [['none', 'Ничего из этого']]"
      }
    },
    {
      "name": "conditions_other",
      "label": "Другое — впишите своё",
